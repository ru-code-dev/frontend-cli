{
  // One config for the whole package — `pixso-cli`'s shape, for the same reason it gives:
  // "a thin bin over [the feature packages'] public API — no web half, no test half of its
  // own" (`ru-code-packages/packages/pixso-cli/tsconfig.json:2-10`). `tests` rides along in
  // the include so the suites are checked at the same strictness as the source.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ESNext"]
  },
  "include": ["src", "tests"],
  // `tests/fixtures/` is test INPUT, not test code: a React mini-project with deliberate
  // accessibility defects, fed to the bundle as a directory to analyse. It is never imported,
  // it needs a `jsx` setting this package has no reason to carry, and its defects are the
  // point — typechecking it would be checking the fixture instead of the product.
  // `packages/fe-analyzer-engine/tsconfig.json:9-15` excludes its copy for the same reason.
  "exclude": ["tests/fixtures"]
}
