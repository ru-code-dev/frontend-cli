{
  // Modelled on `ru-code-packages/packages/pixso-cli/tsconfig.json:5-10`; `tests` rides along
  // in the include so the suites are checked at the same strictness as the source.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ESNext"]
  },
  "include": ["src", "tests"],
  // The fixtures are INPUT, not source — the same call `packages/fe-analyzer-engine` makes for
  // the same reason. They are mini React projects the analyzer reads as text, with deliberate
  // defects and imports (`react`, `@sds-eng/base`, `@v-uik/*`) of packages that are not
  // installed and must not be: the whole premise of this analyzer is that it never installs,
  // builds or executes what it analyses. Typechecking them would be typechecking the test data
  // against dependencies the test data exists to prove are unnecessary.
  "exclude": ["tests/fixtures"]
}
