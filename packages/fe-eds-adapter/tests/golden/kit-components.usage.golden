      "hasInlineSvg": true,
      "snippet": "export const Spinner = ({\n  size = \"md\",\n  view = \"primary\",\n  classes,\n  className,\n  color,\n}: SpinnerProps) => (\n  <span\n    className={`${className ?? \"\"} spinner spinner-${size} spinner-${view}`}\n    role=\"progressbar\"\n    aria-live=\"polite\"\n    style={{ color }}\n  >\n    <svg viewBox=\"0 0 24 24\" className={classes?.[\"circle\"]}>\n      <circle cx=\"12\" cy=\"12\" r=\"10\" />\n    </svg>\n  </span>\n);",
