      "kitComponentsUsed": [],
      "hasInlineSvg": false,
      "snippet": "export const MyButton = ({\n  view = \"primary\",\n  size = \"md\",\n  disabled,\n  fullWidth,\n  classes,\n  onClick,\n  children,\n}: MyButtonProps) => (\n  <button\n    type=\"button\"\n    className={`btn btn-${view} btn-${size}${fullWidth ? \" btn-block\" : \"\"}`}\n    disabled={disabled}\n    onClick={onClick}\n    aria-disabled={disabled}\n  >\n    <span className={classes?.[\"content\"]}>{children}</span>\n  </button>\n);",
      "verdict": "kit-like",
