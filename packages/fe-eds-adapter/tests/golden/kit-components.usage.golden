      "snippet": "export const Card = ({ accent, classes, draggable, elevation, children }: CardProps) => (\n  <div\n    className={`card${accent ? \" card--accent\" : \"\"}`}\n    draggable={draggable}\n    data-elevation={elevation}\n  >\n    <div className={classes?.[\"body\"]}>{children}</div>\n  </div>\n);",
