      "column": 7,
      "snippet": {
        "before": "        Показывать архив\n      </span>\n\n      {/* a11y.aria.redundant: <button> already has role=\"button\". */}\n      <button role=\"button\" type=\"button\" className={styles.action}>\n        Применить\n      </button>\n\n      {/* a11y.pattern.relations / danglingId: no element in this file carries that id. */}",
        "after": "        Показывать архив\n      </span>\n\n      {/* a11y.aria.redundant: <button> already has role=\"button\". */}\n      <button type=\"button\" className={styles.action}>\n        Применить\n      </button>\n\n      {/* a11y.pattern.relations / danglingId: no element in this file carries that id. */}",
        "highlightLine": 5,
        "startLine": 9
      },
      "actual": " role=\"button\"",
      "expected": null,
      "why": "<button> уже имеет роль button. Атрибут ничего не добавляет и создаёт впечатление, что семантика держится на нём, — при рефакторинге тег заменят, а роль оставят.",
