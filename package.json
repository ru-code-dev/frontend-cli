{
  "name": "@smart-tools/frontend-cli-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "fmt": "vp fmt -c .oxfmtrc.json",
    "fmt:check": "vp fmt --check -c .oxfmtrc.json",
    "lint": "vp lint --report-unused-disable-directives",
    "test": "pnpm -r run test",
    "test:integration": "pnpm -r run test:integration",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.18.1"
}
