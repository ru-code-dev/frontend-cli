{
  "name": "@smart-tools/frontend-guard-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "fmt": "vp fmt -c .oxfmtrc.json",
    "fmt:check": "vp fmt --check -c .oxfmtrc.json",
    "lint": "vp lint -c .oxlintrc.json --deny-warnings --report-unused-disable-directives",
    "release": "pnpm -r run build && node scripts/release.mjs",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @smart-tools/fg-testkit test:e2e",
    "test:integration": "pnpm -r run test:integration",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.18.1",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
